[Unit]
Description=SuperScalar Bridge Daemon
# Start order: bitcoind -> superscalar-lsp -> superscalar-bridge -> lightningd.
# The CLN plugin connects to the bridge, so the bridge comes first.
After=superscalar-lsp.service
Before=lightningd.service
Requires=superscalar-lsp.service

[Service]
Type=simple
User=superscalar
Group=superscalar
# The LSP's static public key (it prints it at startup).  Required.
Environment=LSP_PUBKEY=
# Where the bridge keeps the secret it shares with the CLN plugin.  The
# bridge creates the file (mode 0600, owned by User= above) on first start.
# lightningd usually runs as another user: give that user its own copy, e.g.
#   install -o cln -g cln -m 0600 /var/lib/superscalar/bridge-plugin.secret \
#       /var/lib/cln/bridge-plugin.secret
# and set superscalar-bridge-secret-file=/var/lib/cln/bridge-plugin.secret in
# the CLN config.  Repeat the copy if the secret file is ever recreated.
Environment=PLUGIN_SECRET_FILE=/var/lib/superscalar/bridge-plugin.secret
# Address the plugin port binds to.  Leave on loopback unless lightningd
# runs on another host; the link is authenticated but not encrypted.
Environment=PLUGIN_BIND=127.0.0.1
# /var/lib/superscalar (secret), /run/superscalar (pid file) and
# /var/log/superscalar (log), created for and owned by User=.
StateDirectory=superscalar
StateDirectoryMode=0750
RuntimeDirectory=superscalar
LogsDirectory=superscalar
# The plugin port: the same number as superscalar-bridge-port in the CLN
# config (tools/deploy/cln-bridge.conf.example) and the default of both the
# bridge and the plugin.
ExecStart=/usr/local/share/superscalar/tools/deploy/start_bridge.sh \
    --lsp-host 127.0.0.1 --lsp-port 9735 --plugin-port 9736
Restart=on-failure
RestartSec=5
# 78 = the bridge cannot run as configured (missing LSP key, unusable secret
# file or bind address): restarting would only loop.
RestartPreventExitStatus=78
StandardOutput=append:/var/log/superscalar/bridge.log
StandardError=append:/var/log/superscalar/bridge.log

[Install]
WantedBy=multi-user.target
